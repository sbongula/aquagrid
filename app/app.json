{
  "expo": {
    "name": "AquaGrid",
    "slug": "aquagrid",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "AquaGrid uses your location to point the desalination plant at the island you are standing on."
      },
      "bundleIdentifier": "com.sbongula.aquagrid"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#07131B",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "package": "com.sbongula.aquagrid"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "backgroundColor": "#0B1220",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "cover",
      "backgroundColor": "#07131B"
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "AquaGrid uses your location to point the desalination plant at the island you are standing on."
        }
      ]
    ]
  }
}
